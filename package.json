{
  "name": "@logto/tools-root",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "if test \"$NODE_ENV\" != \"production\" && test \"$CI\" != \"true\" ; then husky ; fi",
    "start": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --parallel --workspace-concurrency=0 lint",
    "stylelint": "pnpm -r --parallel --workspace-concurrency=0 stylelint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^16.0.0",
    "only-allow": "^1.2.1",
    "typescript": "^5.7.2",
    "eslint": "^8.56.0",
    "prettier": "^3.0.0",
    "stylelint": "^15.2.0"
  },
  "engines": {
    "node": "^22.0.0",
    "pnpm": "^11.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "^7.29.6",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "fast-uri@<3.1.5": "^3.1.5",
      "immutable@<5.1.8": "^5.1.8",
      "js-yaml@<4.3.1": "^4.3.1",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "shell-quote@<1.9.0": "^1.9.0",
      "ws@<8.21.0": "^8.21.0"
    }
  }
}
