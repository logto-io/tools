{
  "name": "@logto/tools-root",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "if test \"$NODE_ENV\" != \"production\" && test \"$CI\" != \"true\" ; then husky ; fi",
    "start": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --parallel --workspace-concurrency=0 lint",
    "stylelint": "pnpm -r --parallel --workspace-concurrency=0 stylelint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/types": "^20.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^16.0.0",
    "only-allow": "^1.2.1",
    "typescript": "^5.7.2",
    "eslint": "^8.56.0",
    "prettier": "^3.0.0",
    "stylelint": "^17.0.0"
  },
  "engines": {
    "node": "^22.0.0",
    "pnpm": "^10.0.0"
  }
}
