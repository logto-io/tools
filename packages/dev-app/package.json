{
  "name": "@logto/tools-dev-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "precommit": "lint-staged --config ../../lint-staged.config.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint --ext .ts --ext .tsx src vite.config.ts",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests yet for dev app\""
  },
  "dependencies": {
    "@logto/website-ui-foundation": "^0.1.0-beta.0",
    "@logto/tools-base64-decoder": "workspace:^",
    "@logto/website-ui-foundation": "^0.2.0",
    "@logto/tools-jwt-decoder": "workspace:^",
    "classnames": "^2.3.1",
    "@logto/tools-i18nova": "workspace:^",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@silverhand/eslint-config": "^6.0.1",
    "@silverhand/eslint-config-react": "^6.0.2",
    "@silverhand/ts-config": "^6.0.0",
    "@silverhand/ts-config-react": "^6.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.56.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "stylelint": "^15.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.2.7",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^6.0.0",
    "sass-embedded": "^1.93.0"
  },
  "eslintConfig": {
    "extends": "@silverhand/react",
    "rules": {
      "react/jsx-no-target-blank": [
        "error",
        {
          "allowReferrer": true
        }
      ],
      "complexity": "off"
    }
  },
  "prettier": "@silverhand/eslint-config/.prettierrc",
  "stylelint": {
    "extends": "@silverhand/eslint-config-react/.stylelintrc",
    "rules": {
      "scss/function-no-unknown": [
        true,
        {
          "ignoreFunctions": [
            "/^_./"
          ]
        }
      ]
    }
  }
}
