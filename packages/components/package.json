{
  "name": "@logto/tools-components",
  "version": "0.0.0",
  "description": "Local shared UI components for Logto tools.",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "precommit": "lint-staged --config ../../lint-staged.config.cjs",
    "build": "tsc",
    "lint": "eslint --ext .ts --ext .tsx src",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests yet for tools components\""
  },
  "devDependencies": {
    "@silverhand/eslint-config": "^6.0.1",
    "@silverhand/eslint-config-react": "^6.0.2",
    "@silverhand/ts-config": "^6.0.0",
    "@silverhand/ts-config-react": "^6.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.56.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "stylelint": "^17.0.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "classnames": "^2.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "eslintConfig": {
    "extends": "@silverhand/react",
    "rules": {
      "react/jsx-no-target-blank": [
        "error",
        {
          "allowReferrer": true
        }
      ],
      "complexity": "off"
    }
  },
  "prettier": "@silverhand/eslint-config/.prettierrc",
  "stylelint": {
    "extends": "@silverhand/eslint-config-react/.stylelintrc",
    "rules": {
      "scss/function-no-unknown": [
        true,
        {
          "ignoreFunctions": [
            "/^_./"
          ]
        }
      ]
    }
  }
}
